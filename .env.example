# Copy to .env.local for local development (never commit .env.local)
VITE_GOOGLE_CLIENT_ID=
# Optional: pre-fill a default spreadsheet for your own local testing.
# VITE_SHEET_ID=
# Optional: email that gets the Google Calendar invite when you schedule a time to
# do an OA/HireVue. Defaults to the Google account you sign in with.
# VITE_CALENDAR_INVITE_EMAIL=you@example.com

# Optional local test of "add app → empty GitHub commit":
# VITE_GH_PAT=ghp_...
# VITE_GITHUB_REPO=your-user/internship-apps-tracker
